{
  "kind": "collectionType",
  "collectionName": "skills",
  "info": {
    "singularName": "skill",
    "pluralName": "skills",
    "displayName": "Skill",
    "description": "Skills section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "level": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 100
    },
    "category": {
      "type": "enumeration",
      "enum": ["frontend", "backend", "database", "tools", "other"],
      "default": "other"
    },
    "displayGroup": {
      "type": "string"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
