---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Paths of the same page in each language, e.g. { en: '/', de: '/de/' } */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title, description, lang = 'en', alternates, image = '/og.png',
  type = 'website', jsonLd, published, updated, noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const tr = t(lang);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="author" content={profile.fullName} />
  <meta name="theme-color" content="#14213a" />

  {alternates && Object.entries(alternates).map(([l, p]) => (
    <link rel="alternate" hreflang={l} href={new URL(p!, Astro.site)} />
  ))}
  {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={profile.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${profile.name} – Blog`} href={new URL('/rss.xml', Astro.site)} />
  <link rel="sitemap" href="/sitemap-index.xml" />

  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#main">{tr('skip')}</a>
  <Header lang={lang} alternates={alternates} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
