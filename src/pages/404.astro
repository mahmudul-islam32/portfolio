---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Mahmudul Islam" description="This page does not exist." noindex>
  <div class="wrap nf">
    <p class="code mono">404</p>
    <h1>This page doesn't exist</h1>
    <p class="muted">The link may be old or mistyped. You can go to the <a href="/">home page</a>, read the <a href="/blog/">blog</a>, or switch to the <a href="/de/">German version</a>.</p>
  </div>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 12vw, 8rem); max-width: 40rem; margin-inline: auto; }
  .code { color: var(--accent); font-size: 1rem; margin-bottom: 0.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em; margin-bottom: 1rem; }
</style>
