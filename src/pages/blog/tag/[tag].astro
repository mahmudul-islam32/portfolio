---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../../lib/blog';
import { profile } from '../../../data/profile';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugifyTag(t), t)));
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}
const { name, posts } = Astro.props;
---
<Base
  title={`Posts about ${name} · ${profile.name}`}
  description={`Blog posts by ${profile.name} about ${name}.`}
  noindex={posts.length < 3}
>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/blog/">Blog</a></nav>
    <h1>Posts about {name}</h1>
    <p class="muted count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <PostList posts={posts} headingLevel={2} />
  </div>
</Base>

<style>
  .page { padding-block: clamp(3rem, 7vw, 5rem); }
  .crumbs { font-size: 0.9rem; color: var(--ink-3); }
  .crumbs a { color: var(--ink-2); }
  h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em; margin: 0.5rem 0 0.5rem; }
  .count { margin: 0 0 2.5rem; }
</style>
