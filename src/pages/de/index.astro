---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { t } from '../../i18n/ui';
import { personSchema } from '../../lib/schema';
const tr = t('de');
---
<Base
  lang="de"
  title={tr('meta.title')}
  description={tr('meta.description')}
  alternates={{ en: '/', de: '/de/' }}
  type="profile"
  jsonLd={personSchema(Astro.site!, 'de')}
>
  <Home lang="de" />
</Base>
