---
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <p>© {year} {profile.fullName}</p>
    <ul>
      <li><a href={profile.github} rel="me">GitHub</a></li>
      <li><a href={profile.linkedin} rel="me">LinkedIn</a></li>
      <li><a href="/rss.xml">{tr('footer.rss')}</a></li>
      <li><a href="/impressum/">{tr('footer.imprint')}</a></li>
      <li><a href="/datenschutz/">{tr('footer.privacy')}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); padding-block: 2rem; font-size: 0.9rem; color: var(--ink-3); }
  .row { display: flex; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
  p { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--ink-2); text-decoration: none; }
  a:hover { color: var(--ink); text-decoration: underline; }
</style>
