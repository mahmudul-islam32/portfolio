---
import { postUrl, formatDate, readingTime, type Post } from '../lib/blog';
interface Props { posts: Post[]; lang?: 'en' | 'de'; headingLevel?: 2 | 3 }
const { posts, lang = 'en', headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
const min = lang === 'de' ? 'Min. Lesezeit' : 'min read';
---
<ol class="posts">
  {posts.map((p) => (
    <li>
      <time datetime={p.data.date.toISOString()} class="mono">{formatDate(p.data.date, lang)}</time>
      <div>
        <H class="post-title"><a href={postUrl(p)} lang={p.data.lang}>{p.data.title}</a></H>
        <p class="muted" lang={p.data.lang}>{p.data.description}</p>
        <p class="meta">
          <span>{readingTime(p.body)} {min}</span>
          {p.data.lang !== lang && <span class="langflag">{p.data.lang === 'de' ? 'Deutsch' : 'English'}</span>}
          {p.data.draft && <span class="langflag">draft</span>}
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid; grid-template-columns: 10rem 1fr; gap: 0.25rem 2rem;
    padding-block: 1.4rem; border-bottom: 1px solid var(--rule);
  }
  li:first-child { padding-top: 0; }
  time { color: var(--ink-3); padding-top: 0.2rem; font-size: 0.82rem; }
  .post-title { font-size: 1.2rem; margin-bottom: 0.35rem; }
  .post-title a { color: var(--ink); text-decoration: none; }
  .post-title a:hover { color: var(--accent); text-decoration: underline; }
  p { margin: 0 0 0.4rem; max-width: 40rem; }
  .meta { font-size: 0.85rem; color: var(--ink-3); display: flex; gap: 0.75rem; margin: 0; }
  .langflag { border: 1px solid var(--rule); border-radius: 4px; padding: 0 0.35rem; font-size: 0.78rem; }
  @media (max-width: 40rem) { li { grid-template-columns: 1fr; } }
</style>
